# Copy to the project-root .env for local use, fill locally, and chmod 600.
# Never commit or archive the resulting file.
QSX_TG_TOKEN=
QSX_TG_CHAT=
QSX_DISCORD_WEBHOOK_URL=
QSX_WEBSITE_EVENT_URL=
QSX_WEBSITE_EVENT_SECRET=
# Empty values select the developer CHECK defaults.  Set absolute, protected
# paths explicitly in an installed SHADOW or DEMO service.
QSX_CONFIG=
QSX_DATA_DIR=
# For a demo run, copy config.demo.example.json to a private operator config
# and fill these exact broker identity pins.
QSX_EXPECTED_ACCOUNT_ID=
QSX_EXPECTED_BROKER_SERVER=
QSX_IPC_AUTH_SECRET=
QSX_MACRO_PROVIDER_URL=
QSX_INTERMARKET_PROVIDER_URL=
QSX_MACRO_PROVIDER_CREDENTIAL=
QSX_INTERMARKET_PROVIDER_CREDENTIAL=
# RC2 has no real-capital launcher. Do not add real-account authorization data.
